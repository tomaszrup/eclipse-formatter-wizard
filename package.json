{
  "name": "eclipse-formatter-wizard",
  "displayName": "Eclipse Formatter Wizard",
  "description": "Create Eclipse formatter XML with live Java preview",
  "version": "0.0.1",
  "license": "EPL-2.0",
  "publisher": "TomaszRup",
  "engines": {
    "vscode": "^1.105.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onWebviewPanel:eclipseFormatterWizard.panel",
    "onLanguage:xml",
    "workspaceContains:**/*formatter*.xml"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "eclipse-formatter-wizard.openWizard",
        "title": "Open Formatter Wizard",
        "category": "Eclipse Formatter"
      },
      {
        "command": "eclipse-formatter-wizard.createFormatterXml",
        "title": "Create Formatter XML",
        "category": "Eclipse Formatter"
      },
      {
        "command": "eclipse-formatter-wizard.selectPreviewFile",
        "title": "Select Preview Java File",
        "category": "Eclipse Formatter"
      },
      {
        "command": "eclipse-formatter-wizard.showDiffPreview",
        "title": "Show Formatter Preview",
        "category": "Eclipse Formatter"
      }
    ]
  },
  "scripts": {
    "build:java-runner": "bash ./java-runner/build-runner.sh",
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test",
    "package:vsix": "npx @vscode/vsce package --allow-missing-repository --skip-license"
  },
  "devDependencies": {
    "@types/vscode": "1.105.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.56.1",
    "eslint": "^9.39.3",
    "esbuild": "^0.27.3",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}
